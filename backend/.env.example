# ── Todo es opcional. Sin ninguna clave funciona el camino gratuito: Whisper local (voz→texto) y la voz
#    CLONADA en local con los audios de voices/ (o, si no hay, voces genéricas Salomé/Gonzalo).
#    Solo falta el LLM: pon al menos GEMINI_API_KEY.
GEMINI_API_KEY=            # gratis: https://aistudio.google.com/apikey

# ── De pago (mejor calidad). Si están, se usan primero y lo gratuito queda de respaldo automático.
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Voces clonadas de ElevenLabs, una por speaker. Si falta una, ese personaje usa la voz genérica.
VOICE_ID_RECTORA=
VOICE_ID_OSWALDO=

# ── Ajustes (valores por defecto entre paréntesis)
# STT_PROVIDER=auto                  # auto | deepgram | whisper    (auto = de pago si hay clave, gratis si falla)
# LLM_PROVIDER=auto                  # auto | anthropic | gemini
# TTS_PROVIDER=auto                  # auto | elevenlabs | clone | fish | edge   (auto: ElevenLabs si hay clave → clon local → genérica)
#                                    # fish = Fish Audio S2 Pro (probar si clona mejor; 6,7 GB y licencia no comercial; ver README 6c)
# FISH_MODEL=mlx-community/fish-audio-s2-pro-8bit
# FISH_TEMPERATURE=0.7               # menos = más estable y parecido a la referencia
# FISH_REF_MAX_SECONDS=20            # Fish rinde mejor con 10-30 s de referencia
# LLM_MODEL=claude-opus-5-5          # más rápido: claude-sonnet-5-5 o claude-haiku-5-5
# LLM_EFFORT=low                     # low | medium | high | xhigh | max
# GEMINI_MODEL=gemini-3.5-flash-lite # mira en AI Studio qué modelos tienen capa gratuita (p. ej. gemini-3.8-flash)
# GEMINI_THINKING_LEVEL=             # vacío = el del modelo; minimal | low | medium | high  (medido con flash-lite: vacío ≈ minimal; low es más lento)
# GEMINI_FALLBACK_MODEL=gemini-3.8-flash   # segundo modelo gratuito si el primero da 429/503 (la cuota es por modelo)
# FILLER_ENABLED=true                # muletillas habladas mientras se prepara la respuesta (textos en fillers.json)
# FILLER_START_SECONDS=4.0           # la primera suena si pasan más de estos segundos sin respuesta (desde que llega el audio)
# FILLER_IMMINENT_SECONDS=1.5        # si la respuesta ya está en el TTS desde hace menos de esto, espera antes de soltar la muletilla
# FILLER_MAX_CHAIN=3                 # máximo de muletillas seguidas (cada una dura ~4 s)
# WHISPER_MODEL=small                # tiny | base | small | medium | large-v3 (más grande = más preciso y lento)
# TTS_MODEL=eleven_flash_v2_5        # ElevenLabs; probar eleven_v4_turbo si tu plan lo incluye
# ELEVENLABS_OUTPUT_FORMAT=mp3_24000_48
# CLONE_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-Base-4bit   # más ligero: mlx-community/Qwen3-TTS-12Hz-0.6B-Base-4bit
# CLONE_STREAM_INTERVAL=1.0          # segundos de audio por trozo (menos = empieza antes, un poco más de sobrecarga)
# CLONE_REF_MAX_SECONDS=12           # tope de la referencia de voz
# VOICES_DIR=voices                  # carpeta con rectora.wav / oswaldo.wav (ver voices/README.md)
# EDGE_VOICE_RECTORA=es-CO-SalomeNeural    # otras: es-MX-DaliaNeural, es-ES-ElviraNeural...
# EDGE_VOICE_OSWALDO=es-CO-GonzaloNeural   # otras: es-MX-JorgeNeural, es-ES-AlvaroNeural...
# TTS_CONCURRENCY=3                  # llamadas simultáneas a ElevenLabs (según tu plan)
# PRELOAD_PRESENTATION=true          # genera al arrancar las preguntas 1-10 de ambos speakers
# PRESENTATION_REFRESH_SECONDS=60    # mínimo entre dos regeneraciones en segundo plano de una misma pregunta
# LLM_RETRIES=2                      # reintentos si el último LLM falla por sobrecarga (503) antes del primer token
# LLM_RETRY_DELAY=0.6                # segundos antes del primer reintento (se duplica en cada uno)
